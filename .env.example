# Plantilla de secretos para el perfil dev.
# Copiar como .env en la raíz del proyecto y rellenar los valores (.env no se sube a git).
# application-dev.properties lo carga con spring.config.import.

# Contraseña del usuario qhcube_usr de la base de datos local (contenedor mysql-dev)
DB_PASSWORD=

# Contraseña de la cuenta de correo qhcube.etsisi@upm.es
MAIL_PASSWORD=

# Clave para firmar los tokens JWT (cualquier cadena larga y aleatoria)
JWT_SECRET=
